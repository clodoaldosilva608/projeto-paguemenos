# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env real! (já está no .gitignore)

# === Supabase (públicas no client) ===
SUPABASE_PROJECT_ID="seu-project-id"
SUPABASE_URL="https://seu-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_URL="https://seu-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# === Supabase service role (SEGREDO — apenas server-side) ===
# NUNCA coloque este valor em vercel.json. Use o painel da Vercel:
# Project Settings → Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=""

# === Connection string para scripts de migration locais ===
# Apenas para scripts/apply-migrations-pg.mjs — NUNCA usado em runtime.
DATABASE_URL=""

# === Credenciais para o script de verificação de isolamento ===
# src/scripts/verify-isolation.ts carrega estas variáveis do .env.
# Considerando que o .env já está no .gitignore, isto evita que credenciais
# reais sejam commitadas no repositório (incidente histórico).
# As contas abaixo devem ser APENAS contas de teste — troque a senha
# de qualquer conta real que tenha sido exposta no histórico do git.
SUPABASE_ANON_KEY=""
TEST_ADMIN_EMAIL=""
TEST_ADMIN_PASSWORD=""
TEST_GERENTE_1001_EMAIL=""
TEST_GERENTE_1001_PASSWORD=""
TEST_GERENTE_2001_EMAIL=""
TEST_GERENTE_2001_PASSWORD=""
TEST_SUPERVISOR_1001_EMAIL=""
TEST_SUPERVISOR_1001_PASSWORD=""
TEST_VENDEDOR_1001_EMAIL=""
TEST_VENDEDOR_1001_PASSWORD=""
TEST_VENDEDOR_2002_EMAIL=""
TEST_VENDEDOR_2002_PASSWORD=""
